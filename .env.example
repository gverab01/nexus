# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - NEXUSREACH PRO (PLANTILLA OFICIAL)
# ==============================================================================

# 1. Motor de Base de Datos Principal (PostgreSQL 16+ Obligatorio)
DB_ENGINE=postgres
# URL de conexión con rol no privilegiado nexus_app:
DATABASE_URL=postgresql://nexus_app:app_secure_password@127.0.0.1:5432/nexusreach_prod

# 2. Token Criptográfico para Bypass SuperAdmin (RLS)
# Token de 64 caracteres hex generado criptográficamente (secrets.token_hex(32))
SUPERADMIN_RLS_SECRET=your_64_character_hex_secret_here

# 3. Entorno de Ejecución (production / staging / development)
ENV=production
ENVIRONMENT=production

# 4. Servidor Backend FastAPI
PORT=8000
HOST=127.0.0.1

# 5. Seguridad y Sesiones
SESSION_EXPIRE_HOURS=24
