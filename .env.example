# ==============================================================================
# CONFIGURACIÓN DE ENTORNO - NEXUSREACH PRO
# ==============================================================================

# 1. Base de Datos
# Dejar vacío para usar SQLite local (leads.db en modo WAL):
DATABASE_URL=

# Para conectar a PostgreSQL en la nube (Neon, Supabase, Railway, Render, AWS RDS),
# descomenta y completa tu URL de conexión:
# DATABASE_URL=postgresql://usuario:password@ep-ejemplo.us-east-2.aws.neon.tech/nexus_db?sslmode=require
# DATABASE_URL=postgresql://postgres.xxx:password@aws-0-us-east-1.pooler.supabase.com:6543/postgres

# 2. Servidor Backend FastAPI
PORT=8000
HOST=127.0.0.1

# 3. Seguridad y Tokens
JWT_SECRET=nexusreach_secret_key_change_in_production
SESSION_EXPIRE_HOURS=24
